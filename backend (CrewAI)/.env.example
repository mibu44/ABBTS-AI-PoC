# Copy this template to .env for local development.
# Gemini Developer API (Google AI Studio)
GEMINI_API_KEY=
CAMPUS_MODEL=gemini/gemini-3.5-flash-lite

# Optional OpenAI configuration. Set CAMPUS_MODEL=openai/gpt-4o-mini when using it.
# OPENAI_API_KEY=
CAMPUS_CLASS=IF-24-27-BA-K1-S5
TIMETABLE_MCP_URL=http://127.0.0.1:8080/mcp

# Optional DigitalOcean Knowledge Base settings
DO_KNOWLEDGE_BASE_ID=
DO_KNOWLEDGE_BASE_TOKEN=

# Optional alternative RAG endpoint
RAG_URL=
RAG_TOKEN=
